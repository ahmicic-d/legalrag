# ---------- PostgreSQL ----------
POSTGRES_USER=legalrag
POSTGRES_PASSWORD=legalrag
POSTGRES_DB=legalrag

# ---------- Backend ----------
# Za pokretanje izvan Dockera:
# DATABASE_URL=postgresql+psycopg://legalrag:legalrag@localhost:5432/legalrag

# Embedding model (višejezični, radi za hrvatski)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ---------- LLM (Ollama ili OpenAI-kompatibilan API) ----------
# Ollama u Docker Compose mreži:
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.1
# API ključ NIKADA ne commitajte u repozitorij. Za Ollamu ostaje prazan.
LLM_API_KEY=

# Primjer za OpenAI-kompatibilan servis:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# ---------- CORS / Frontend ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
